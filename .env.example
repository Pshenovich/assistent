TELEGRAM_BOT_TOKEN=

# Публичный HTTPS URL мини-приложения (без завершающего слэша).
WEBAPP_PUBLIC_URL=https://assistent.networ.ru
# APP_URL — алиас WEBAPP_PUBLIC_URL, если тот не задан.
# APP_URL=https://assistent.networ.ru

MINIAPP_DEV_MODE=0
# MINIAPP_DEV_TELEGRAM_USER_ID=
# MINIAPP_DEV_BEARER=miniapp-local-dev

OPENROUTER_KEY=
OBUCHAT_TRANSCRIBE=
# Прокси через assistant.obuchat.me (если истёк SSL на transcribe.obuchat.me):
OBUCHAT_TRANSCRIBE_BASE=https://assistant.obuchat.me/transcribe-api
# OBUCHAT_TRANSCRIBE_BASE=https://transcribe.obuchat.me/api/v1

# TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
# TELEGRAM_BOT_USERNAME=

# AI Executive Board — отдельный бот (не путать с TELEGRAM_BOT_TOKEN)
# TG_DONATELLO_BOT_TOKEN=
# TG_DONATELLO_BOT_USERNAME=@PshLeo_bot
# BOARD_DB_PATH=./data/board.sqlite
# Живой документ компании (публичная /share/ ссылка миниаппа Leo).
# По умолчанию — каталог «Все продукты». off — выключить.
# В промпт агентов идёт не весь документ, а индекс + релевантные фрагменты:
# BOARD_COMPANY_SHARE_URL=https://assistent.networ.ru/share/lYS_LYaj9MI3aIGHJib2Tyn1nNLAZ-eO
# BOARD_COMPANY_CTX_CHARS=4000
# BOARD_COMPANY_EXCERPTS=3
# OPENROUTER_MODEL_BOARD=
# Если кредиты OpenRouter кончились — бесплатная модель, например:
# OPENROUTER_MODEL_BOARD=minimax/minimax-m2.7:free
# OPENROUTER_MODEL_BOARD_FALLBACK=google/gemma-4-31b-it:free
# BOARD_MAX_ROUNDS=4
# После 4 кругов CHAIR решает. Если confidence ниже порога — ещё круги:
# BOARD_HIGH_CONFIDENCE=0.75
# BOARD_EXTRA_ROUNDS=2
# BOARD_MAX_MESSAGES=16
# BOARD_MAX_MEETING_SEC=300
# BOARD_DELAY_MIN_SEC=2
# BOARD_DELAY_MAX_SEC=6
# BOARD_FOLLOWUPS_ENABLED=1
# BOARD_FOLLOWUP_POLL_SEC=60
# BOARD_LLM_TIMEOUT_SEC=90
# Лимит скачивания из Telegram (МБ). Облачный Bot API — макс. 20 МБ.
# TELEGRAM_BOT_MAX_DOWNLOAD_MB=20
# Локальный telegram-bot-api на VPS (снимает лимит 20 МБ): docs/local-bot-api.md
# TELEGRAM_BOT_API_BASE_URL=http://127.0.0.1:8081
# TELEGRAM_BOT_API_DATA_DIR=/opt/assistant/data/telegram-bot-api
# Rich Message (sendRichMessage): по умолчанию api.telegram.org — локальный Bot API часто без этого метода
# TELEGRAM_RICH_BOT_API_BASE_URL=https://api.telegram.org
# TELEGRAM_LOCAL_BOT_API_MAX_DOWNLOAD_MB=500
# Прямая ссылка на файл для транскрипции (МБ)
# URL_MAX_DOWNLOAD_MB=500

GOOGLE_CALENDAR_ID=primary
GOOGLE_WEB_CLIENT_SECRETS_PATH=./OAuth Client ID AssitentAI.json
GOOGLE_OAUTH_REDIRECT_URI=https://assistant.obuchat.me/oauth/google/callback

TODOIST_OAUTH_CLIENT_ID=
TODOIST_OAUTH_CLIENT_SECRET=
TODOIST_OAUTH_REDIRECT_URI=https://assistant.obuchat.me/oauth/todoist/callback

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=https://assistant.obuchat.me/oauth/zoom/callback
# Zoom Marketplace → Development → Redirect URL for OAuth (отдельно от Production):
# ZOOM_OAUTH_REDIRECT_URI_DEV=https://stagassistant.obuchat.me/oauth/zoom/callback
# Client ID и Secret — из ОДНОГО приложения и ОДНОЙ вкладки (Development или Production). Не смешивать ID и Secret разных приложений.
# Production (на сервере assistant.obuchat.me): Client ID 25bg0QtHTVyrLWzx1WQwgQ
# Development (локально / stagassistant): Client ID wHjAp0zkSRqrj4MiYnWseQ
# Production Authorization URL for Marketplace listing (bot adds state+scope at runtime):
# https://zoom.us/oauth/authorize?response_type=code&client_id=25bg0QtHTVyrLWzx1WQwgQ&redirect_uri=https://assistant.obuchat.me/oauth/zoom/callback
ZOOM_OAUTH_SCOPE=meeting:write:meeting meeting:read:list_meetings meeting:update:meeting meeting:delete:meeting user:read:user user:read:token
# Zoom Marketplace reviewer test account (scripts/add_zoom_reviewer_allowlist.sh):
# ZOOM_REVIEWER_TELEGRAM_USER_ID=
# ZOOM_REVIEWER_TELEGRAM_USERNAME=
ZOOM_WEBHOOK_URL=https://assistant.obuchat.me/webhook
ZOOM_DEAUTH_WEBHOOK_URL=https://assistant.obuchat.me/webhook/deauthorize
ZOOM_WEBHOOK_SECRET=
ZOOM_HOME_URL=https://assistant.obuchat.me/zoom/home
# Marketplace: Event Subscriptions — meeting.ended only. No cloud_recording scope (recordings via meeting bot).
# Deauthorization Notification Endpoint — ZOOM_DEAUTH_WEBHOOK_URL
ZOOM_AUTO_ATTACH_ON_CALENDAR_CREATE=1

# Яндекс Телемост — создание ссылок на видеовстречи (OAuth на oauth.yandex.ru).
# API доступен только для Яндекс 360 для бизнеса на домене организации.
TELEMOST_OAUTH_CLIENT_ID=
TELEMOST_OAUTH_CLIENT_SECRET=
TELEMOST_OAUTH_REDIRECT_URI=https://assistant.obuchat.me/oauth/telemost/callback
# Можно использовать те же CLIENT_ID/SECRET, что и для YANDEX_DISK_OAUTH_*.
TELEMOST_OAUTH_SCOPE=telemost-api:conferences.create telemost-api:conferences.read telemost-api:conferences.update telemost-api:conferences.delete
# 1 (по умолчанию) — не передавать scope в authorize URL; права берутся из oauth.yandex.ru.
TELEMOST_OAUTH_OMIT_SCOPE=1
TELEMOST_MAIL_OAUTH_SCOPE=mail:imap_ro
TELEMOST_AUTO_ATTACH_ON_CALENDAR_CREATE=1
# Фаза 2: ingest писем с конспектами Телемоста (добавьте mail:imap_ro в OAuth-приложение).
# TELEMOST_MAIL_INGEST_ENABLED=0
# TELEMOST_MAIL_POLL_SEC=300
# TELEMOST_MAIL_OAUTH_SCOPE=mail:imap_ro

# Яндекс Диск — сохранение Zoom-записей (OAuth на oauth.yandex.ru).
YANDEX_DISK_OAUTH_CLIENT_ID=
YANDEX_DISK_OAUTH_CLIENT_SECRET=
YANDEX_DISK_OAUTH_REDIRECT_URI=https://assistant.obuchat.me/oauth/yandex-disk/callback
# Если Яндекс не даёт свой callback, используйте встроенный (ручной ввод кода):
# YANDEX_DISK_OAUTH_REDIRECT_URI=https://oauth.yandex.ru/verification_code
# Альтернативное имя переменной: YANDEX_REDIRECT_URI
YANDEX_DISK_OAUTH_SCOPE="cloud_api:disk.read cloud_api:disk.write"
YANDEX_DISK_UPLOAD_ROOT=disk:/Leo/Записи встреч

# Meeting bot (self-hosted Vexa) — запись Zoom-встреч. По умолчанию выключено.
# MEETING_BOT_ENABLED=0
# VEXA_API_BASE=http://127.0.0.1:8056
# VEXA_API_KEY=
# VEXA_WEBHOOK_SECRET=
# MEETING_BOT_NAME=Leo
# MEETING_BOT_JOIN_EARLY_MIN=2
# MEETING_BOT_SCHEDULER_ENABLED=1
# MEETING_BOT_POLL_SEC=60
# MEETING_RECORDINGS_DB_PATH=./data/meeting_recordings.sqlite

# Bitrix24 MCP (per-user tokens в миниаппе; Python 3.10+)
BITRIX_MCP_URL=https://mcp.bitrix24.tech/mcp/
# BITRIX_MCP_AGENT_MAX_STEPS=8
# OPENROUTER_MODEL_BITRIX=

NOTES_DB_PATH=./notes.sqlite
USAGE_DB_PATH=./usage.sqlite
REMINDERS_STORE_PATH=./reminders.json

CALENDAR_TZ=Europe/Moscow
SMOOTH_OUTPUT=1

# Одобрение новых пользователей (Telegram user id администратора, через запятую)
TELEGRAM_ACCESS_APPROVER_IDS=
TELEGRAM_ACCESS_GATE_ENABLED=1

# Напоминание за N минут до встречи (проверка календаря раз в минуту)
MEETING_REMINDERS_ENABLED=1
MEETING_REMINDER_MINUTES_BEFORE=15
MEETING_REMINDER_POLL_SEC=60

# Кэш списка календарей Google (секунды)
CALENDAR_LIST_CACHE_TTL_SEC=21600

# В группах: реакция 👀 на сообщение, которое бот принял в обработку
TELEGRAM_GROUP_SEEN_REACTION_ENABLED=1

# SSH deploy origin (бот / /opt/assistant)
# SSH_USERNAME=root@host
# SSH_PASSWORD=
# SSH_IP=
# GITLAB_DEPLOY_TOKEN=

# SSH deploy edge (nginx для assistent.networ.ru)
# DEPLOY_SSH_HOST=91.229.90.4
# DEPLOY_SSH_USER=root
# DEPLOY_SSH_PASSWORD=
