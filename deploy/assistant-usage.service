[Unit]
Description=Telegram assistant web (OAuth, miniapp, usage dashboard)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/assistant
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/assistant/.venv/bin/uvicorn usage_server:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
