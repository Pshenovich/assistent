[Unit]
Description=Orbita background jobs worker (reminders, briefs, mail, digests)
After=network.target telegram-bot-api.service
Wants=telegram-bot-api.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/assistant
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/assistant/.venv/bin/python worker.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
